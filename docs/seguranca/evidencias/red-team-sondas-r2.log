================ Runner usado (copia integral) ================
#!/usr/bin/env bash
# Runner do Red Team r2: cluster novo .pgrt2:5492, usuario de SO pgtest.
set -u
RAIZ=/home/claude/saas-agenda
PGBIN=/usr/lib/postgresql/16/bin
DIR=$RAIZ/.pgrt2; PORTA=5492
SEG=$RAIZ/docs/seguranca/evidencias
LOG=$SEG/red-team-sondas-r2.log
PS="psql -X -h $DIR -p $PORTA"
[ -f "$DIR/data/postmaster.pid" ] && runuser -u pgtest -- $PGBIN/pg_ctl -D "$DIR/data" -m fast -w stop >/dev/null 2>&1
rm -rf "$DIR"; mkdir -p "$DIR"; chown pgtest:pgtest "$DIR"; chmod 700 "$DIR"
runuser -u pgtest -- $PGBIN/initdb -D "$DIR/data" -U pgtest --auth=trust -E UTF8 --locale=C.UTF-8 >/dev/null || exit 1
runuser -u pgtest -- $PGBIN/pg_ctl -D "$DIR/data" -w -l "$DIR/pg.log" -o "-p $PORTA -k $DIR -c listen_addresses=''" start >/dev/null || exit 1
{
echo "# red-team-sondas-r2 $(date -u +%FT%TZ)"
echo "# versao: $($PS -U pgtest -d postgres -Atc 'select version()')"
echo "# cluster novo: $DIR porta $PORTA, usuario de SO pgtest (nao-root), auth trust local"
echo "# comandos: create database r2; psql -v ON_ERROR_STOP=1 -f docs/arquitetura/modelo-v2.sql; psql -f docs/seguranca/evidencias/red-team-sondas-r2.sql"
$PS -U pgtest -d postgres -qc 'create database r2'
$PS -U pgtest -d r2 -v ON_ERROR_STOP=1 -q -f $RAIZ/docs/arquitetura/modelo-v2.sql >/dev/null 2>&1; echo "modelo-v2.sql exit=$?"
$PS -U pgtest -d r2 -f $SEG/red-team-sondas-r2.sql 2>&1; echo "red-team-sondas-r2.sql exit=$?"
echo ""
echo "================ R2N7g opcao de arranque: PGOPTIONS='-c track_activities=on' como saas_app (esperado: negado) ================"
PGOPTIONS='-c track_activities=on' $PS -U saas_app -d r2 -Atc "show track_activities" 2>&1
echo ""
echo "================ R2N9 log do servidor entre as marcas (ALERTA_DDL_SAAS = alerta emitido) ================"
grep -E "MARCA_R2N9|ALERTA_DDL_SAAS" "$DIR/pg.log" | sed -E 's/^[0-9-]+ [0-9:.]+ [A-Z]+ \[[0-9]+\] //' | grep -v CONTEXT
} > "$LOG" 2>&1
runuser -u pgtest -- $PGBIN/pg_ctl -D "$DIR/data" -m fast -w stop >/dev/null 2>&1
echo feito

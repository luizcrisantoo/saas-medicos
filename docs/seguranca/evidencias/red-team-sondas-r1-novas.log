N1c funcoes de QUALQUER schema executaveis por saas_app/saas_jobs/saas_auth alcancaveis (schema com USAGE), fora de pg_catalog/information_schema
SELECT r.rolname, n.nspname, count(*) AS funcoes
  FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
  CROSS JOIN (VALUES ('saas_app'),('saas_jobs'),('saas_auth')) r(rolname)
 WHERE n.nspname NOT IN ('pg_catalog','information_schema')
   AND has_function_privilege(r.rolname, p.oid, 'EXECUTE')
   AND has_schema_privilege(r.rolname, n.oid, 'USAGE')
 GROUP BY 1,2 ORDER BY 1,2;
  rolname  | nspname | funcoes 

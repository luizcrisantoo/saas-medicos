CREATE FUNCTION bloqueia_alteracao() RETURNS trigger LANGUAGE plpgsql
  SET search_path = saas, pg_temp AS
$$ BEGIN
  RAISE EXCEPTION 'tabela % e so de inclusao (%)', TG_TABLE_NAME, TG_OP;
END $$;
CREATE FUNCTION
CREATE TRIGGER evento_auditoria_so_inclusao
  BEFORE UPDATE OR DELETE ON evento_auditoria FOR EACH ROW EXECUTE FUNCTION bloqueia_alteracao();
CREATE TRIGGER
CREATE TRIGGER evento_auditoria_sem_truncate
  BEFORE TRUNCATE ON evento_auditoria FOR EACH STATEMENT EXECUTE FUNCTION bloqueia_alteracao();
CREATE TRIGGER
CREATE TRIGGER historico_so_inclusao
  BEFORE UPDATE OR DELETE ON historico_status_encaminhamento FOR EACH ROW EXECUTE FUNCTION bloqueia_alteracao();
CREATE TRIGGER
CREATE TRIGGER historico_sem_truncate
  BEFORE TRUNCATE ON historico_status_encaminhamento FOR EACH STATEMENT EXECUTE FUNCTION bloqueia_alteracao();
CREATE TRIGGER
CREATE FUNCTION registra_historico_status() RETURNS trigger LANGUAGE plpgsql
  SET search_path = saas, pg_temp AS
$$ BEGIN
  IF NEW.status IS DISTINCT FROM OLD.status THEN
    INSERT INTO historico_status_encaminhamento
      (encaminhamento_id, status_anterior, status_novo, autor_papel, autor_id)
    VALUES
      (NEW.id,
       OLD.status,
       NEW.status,
       coalesce(app_papel(), 'DESCONHECIDO'),
       coalesce(app_usuario(), app_profissional_id(), app_paciente_id()));
    NEW.atualizado_em := now();
  END IF;
  RETURN NEW;
END $$;
CREATE FUNCTION
CREATE FUNCTION registra_historico_criacao() RETURNS trigger LANGUAGE plpgsql
  SET search_path = saas, pg_temp AS
$$ BEGIN
  INSERT INTO historico_status_encaminhamento
    (encaminhamento_id, status_anterior, status_novo, autor_papel, autor_id)
  VALUES (NEW.id, NULL, NEW.status, coalesce(app_papel(), 'DESCONHECIDO'),
          coalesce(app_usuario(), app_profissional_id(), app_paciente_id()));
  RETURN NULL;
END $$;
CREATE FUNCTION
CREATE TRIGGER encaminhamento_historico_criacao
  AFTER INSERT ON encaminhamento FOR EACH ROW EXECUTE FUNCTION registra_historico_criacao();
CREATE TRIGGER
CREATE TRIGGER encaminhamento_historico_status
  BEFORE UPDATE OF status ON encaminhamento FOR EACH ROW EXECUTE FUNCTION registra_historico_status();
CREATE TRIGGER
CREATE FUNCTION eh_equipe(papeis text[]) RETURNS boolean LANGUAGE sql STABLE
  SET search_path = saas, pg_temp AS
$$ SELECT app_clinica_id() IS NOT NULL
      AND app_papel() = ANY (papeis)
      AND EXISTS (SELECT 1 FROM usuario_clinica uc
                   WHERE uc.usuario_id = app_usuario()
                     AND uc.clinica_id = app_clinica_id()
                     AND uc.papel = app_papel()
                     AND uc.ativo) $$;
CREATE FUNCTION
